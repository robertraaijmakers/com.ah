# Copy to .env and fill in values
DB_PASSWORD=changeme_secure_password

# Ollama — runs natively on macOS, not in Docker
# Install: brew install ollama && ollama serve && ollama pull qwen2.5:14b
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b

# Scraper schedules (cron syntax)
PRODUCTS_CRON=0 6 * * *    # daily 06:00
BONUS_CRON=0 8 * * 4       # Thursday 08:00
ORDERS_CRON=0 7 * * 1      # Monday 07:00
